private data class ActualTrade(val id: String, val date: String, val area: Double?, val amount: Double?, val floor: String, val canceled: Boolean)
private data class TradeResponse(val rows: List<ActualTrade>, val total: Int)
private fun moneyLabel(amount: Double?): String {
    if (amount == null) return "금액 미상"
    val n = amount.toLong()
    return if (n >= 10000) "${n / 10000}억" + (if (n % 10000 == 0L) "" else " ${String.format(Locale.KOREA, "%,d", n % 10000)}만")
    else "${String.format(Locale.KOREA, "%,d", n)}만"
}
private fun areaKey(area: Double?) = area?.let { String.format(Locale.US, "%.1f", it) } ?: "미상"
private suspend fun loadActualTrades(base: String, code: String): TradeResponse = withContext(Dispatchers.IO) {
    val c = URL("${base.trimEnd('/')}/api/apartment-v2-detail/?kapt_code=${URLEncoder.encode(code, "UTF-8")}&years=3&limit=500").openConnection() as HttpURLConnection
    try {
        c.connectTimeout = 10000; c.readTimeout = 30000
        c.setRequestProperty("Accept", "application/json")
        val status = c.responseCode
        val body = (if (status in 200..299) c.inputStream else c.errorStream)?.bufferedReader(Charsets.UTF_8)?.use { it.readText() } ?: ""
        if (status !in 200..299) error("HTTP $status: ${body.take(180)}")
        val json = JSONObject(body)
        if (!json.optBoolean("ok")) error(json.optString("error", "실거래 조회 실패"))
        val arr = json.optJSONArray("trades") ?: error("서버 응답에 trades가 없습니다.")
        val rows = (0 until arr.length()).map { i ->
            val o = arr.getJSONObject(i)
            val area = o.optDouble("area", Double.NaN).takeIf { it.isFinite() }
            val amount = o.optDouble("deal_amount", Double.NaN).takeIf { it.isFinite() && it > 0 }
            val cancel = o.optString("cdeal_type").trim()
            val cancelDay = o.optString("cdeal_day").trim()
            ActualTrade(o.optString("id", "$i"), o.optString("deal_date"), area, amount,
                if (o.isNull("floor")) "미상" else o.optString("floor"),
                cancel in listOf("O", "Y", "1", "취소", "해제") || cancelDay !in listOf("", "null", "-"))
        }
        TradeResponse(rows, json.optInt("trade_count", rows.size))
    } finally { c.disconnect() }
}

@Composable
fun ServerApartmentDetail(apt: ServerApartment) {
    var data by remember(apt.kaptCode) { mutableStateOf<TradeResponse?>(null) }
    var loading by remember(apt.kaptCode) { mutableStateOf(true) }
    var failure by remember(apt.kaptCode) { mutableStateOf<String?>(null) }
    var retry by remember(apt.kaptCode) { mutableIntStateOf(0) }
    var years by remember(apt.kaptCode) { mutableIntStateOf(3) }
    var area by remember(apt.kaptCode) { mutableStateOf("전체") }
    var tab by remember(apt.kaptCode) { mutableIntStateOf(0) }
    LaunchedEffect(apt.kaptCode, retry) {
        loading = true; failure = null
        try { data = loadActualTrades("http://127.0.0.1:8001", apt.kaptCode) }
        catch (e: CancellationException) { throw e }
        catch (e: Exception) { failure = e.message ?: "실거래 조회 실패" }
        finally { loading = false }
    }
    val dateFormat = remember { SimpleDateFormat("yyyy-MM-dd", Locale.US) }
    val cutoff = dateFormat.format(Calendar.getInstance().apply { add(Calendar.YEAR, -years) }.time)
    val today = dateFormat.format(Calendar.getInstance().time)
    val all = data?.rows.orEmpty()
    val areas = all.map { areaKey(it.area) }.filter { it != "미상" }.distinct().sortedBy { it.toDouble() }
    val visible = all.filter { it.date.length == 10 && it.date >= cutoff && it.date <= today && (area == "전체" || areaKey(it.area) == area) }.sortedByDescending { it.date }
    val valid = visible.filter { !it.canceled }
    Column(Modifier.fillMaxSize()) {
        TabRow(selectedTabIndex = tab) {
            listOf("실거래", "단지정보", "중개사·매물").forEachIndexed { i, title ->
                Tab(selected = tab == i, onClick = { tab = i }, text = { Text(title) })
            }
        }
        LazyColumn(modifier = Modifier.weight(1f), contentPadding = PaddingValues(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
            item {
                Text(apt.name, style = MaterialTheme.typography.titleLarge, fontWeight = FontWeight.Bold)
                Text(apt.dong)
            }
            if (tab == 0) {
                item {
                    Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                        listOf(1, 3).forEach { n -> FilterChip(selected = years == n, onClick = { years = n }, label = { Text("최근 ${n}년") }) }
                    }
                    Row(Modifier.fillMaxWidth().horizontalScroll(rememberScrollState()), horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                        (listOf("전체") + areas).forEach { a -> FilterChip(selected = area == a, onClick = { area = a }, label = { Text(if (a == "전체") "전용면적 전체" else "${a}m²") }) }
                    }
                }
                if (loading) item { LinearProgressIndicator(Modifier.fillMaxWidth()); Text("실거래 조회 중…") }
                if (failure != null) item {
                    Text("조회 실패: $failure", color = MaterialTheme.colorScheme.error)
                    Button(onClick = { retry++ }, enabled = !loading) { Text("다시 조회") }
                }
                if (data != null && !loading && failure == null) {
                    item {
                        Text("선택 조건 유효 거래 ${valid.size}건", fontWeight = FontWeight.Bold)
                        Text("서버 수신 ${all.size}건 / 서버 집계 ${data!!.total}건", style = MaterialTheme.typography.bodySmall)
                        if (data!!.total > all.size) Text("최신 500건 한도로 일부 거래만 수신했습니다. 그래프·필터는 수신 자료 기준입니다.", color = MaterialTheme.colorScheme.error)
                        Text("취소 거래는 그래프·유효 건수에서 제외합니다. 면적 전체 선택 시 서로 다른 면적의 가격이 함께 집계됩니다.", style = MaterialTheme.typography.bodySmall)
                    }
                    item { ActualTradeChart(valid, cutoff, today) }
                    item { Text("실거래 내역 · ${visible.size}건", style = MaterialTheme.typography.titleMedium) }
                    if (visible.isEmpty()) item { Text("선택 조건에 해당하는 거래가 없습니다.") }
                    items(visible) { t ->
                        Card(Modifier.fillMaxWidth()) {
                            Column(Modifier.padding(14.dp), verticalArrangement = Arrangement.spacedBy(4.dp)) {
                                Text(t.date + if (t.canceled) " · 계약 취소" else "", color = if (t.canceled) MaterialTheme.colorScheme.error else MaterialTheme.colorScheme.onSurface)
                                Text(moneyLabel(t.amount), fontWeight = FontWeight.Bold, style = MaterialTheme.typography.titleMedium)
                                Text("전용 ${areaKey(t.area)}m² · ${t.floor}층")
                            }
                        }
                    }
                }
            } else if (tab == 1) item { Text("단지코드: ${apt.kaptCode}\n법정동 코드: ${apt.bjdCode}") }
            else item { Text("중개사·매물 연동은 아직 적용하지 않았습니다.") }
        }
    }
}

@Composable
private fun ActualTradeChart(trades: List<ActualTrade>, cutoff: String, today: String) {
    val months = mutableListOf<String>()
    val cal = Calendar.getInstance().apply {
        set(Calendar.DAY_OF_MONTH, 1)
        set(Calendar.YEAR, cutoff.substring(0, 4).toInt())
        set(Calendar.MONTH, cutoff.substring(5, 7).toInt() - 1)
    }
    val fmt = SimpleDateFormat("yyyy-MM", Locale.US)
    while (fmt.format(cal.time) <= today.take(7)) { months.add(fmt.format(cal.time)); cal.add(Calendar.MONTH, 1) }
    val grouped = trades.groupBy { it.date.take(7) }
    val averages = months.map { month -> grouped[month].orEmpty().mapNotNull { it.amount }.takeIf { it.isNotEmpty() }?.average()?.div(10000.0)?.toFloat() }
    val counts = months.map { grouped[it].orEmpty().size }
    val priceValues = averages.filterNotNull()
    if (priceValues.isEmpty()) { Text("그래프로 표시할 유효 가격이 없습니다."); return }
    val low = (priceValues.minOrNull()!! * 0.95f).coerceAtLeast(0f)
    val high = maxOf(priceValues.maxOrNull()!! * 1.05f, low + 0.1f)
    val countMax = maxOf(counts.maxOrNull() ?: 0, 1)
    val green = Color(0xFF087F68); val red = Color(0xFFC65757)
    Card(Modifier.fillMaxWidth()) {
        Column(Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(8.dp)) {
            Text("월별 평균 실거래가·거래건수", fontWeight = FontWeight.Bold)
            Text("초록: 평균가(억, 왼쪽) / 빨강: 거래건수(건, 오른쪽)", style = MaterialTheme.typography.labelSmall)
            Row(Modifier.fillMaxWidth()) {
                Column(Modifier.width(40.dp).height(190.dp), verticalArrangement = Arrangement.SpaceBetween) {
                    listOf(high, (high + low) / 2, low).forEach { Text(String.format(Locale.KOREA, "%.1f", it), color = green, style = MaterialTheme.typography.labelSmall) }
                }
                Canvas(Modifier.weight(1f).height(190.dp)) {
                    val step = size.width / months.size
                    repeat(3) { i -> val y = size.height * i / 2f; drawLine(Color.Gray.copy(alpha = 0.2f), Offset(0f, y), Offset(size.width, y)) }
                    counts.forEachIndexed { i, n ->
                        val h = size.height * n / countMax.toFloat()
                        drawRect(red.copy(alpha = 0.45f), Offset(step * i + step * 0.2f, size.height - h), Size(step * 0.6f, h))
                    }
                    val path = Path(); var previous = false
                    averages.forEachIndexed { i, p ->
                        if (p == null) previous = false
                        else {
                            val x = step * (i + 0.5f); val y = size.height * (1f - (p - low) / (high - low))
                            if (previous) path.lineTo(x, y) else path.moveTo(x, y)
                            previous = true; drawCircle(green, 3.dp.toPx(), Offset(x, y))
                        }
                    }
                    drawPath(path, green, style = Stroke(width = 2.dp.toPx()))
                }
                Column(Modifier.width(28.dp).height(190.dp), verticalArrangement = Arrangement.SpaceBetween) {
                    listOf(countMax, countMax / 2, 0).forEach { Text("$it", color = red, style = MaterialTheme.typography.labelSmall) }
                }
            }
            Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
                Text(months.first(), style = MaterialTheme.typography.labelSmall)
                Text(months[months.size / 2], style = MaterialTheme.typography.labelSmall)
                Text(months.last(), style = MaterialTheme.typography.labelSmall)
            }
            Text("거래 없는 달은 0건이며 가격 선은 연결하지 않습니다.", style = MaterialTheme.typography.labelSmall)
        }
    }
}
